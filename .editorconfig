root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,json,jsonc,css,yml,yaml}]
indent_style = space
indent_size = 2

[*.{sh,toml}]
indent_style = space
indent_size = 4
